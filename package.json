{
  "name": "@thisisayande/terminal-heatmap",
  "version": "1.2.0",
  "description": "A highly customizable and scalable contribution heatmap for the terminal, like GitHub's.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "terminal-heatmap": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "heatmap",
    "github",
    "contribution",
    "terminal",
    "cli",
    "ansi",
    "console",
    "calendar"
  ],
  "author": "Ayan De",
  "license": "MIT",
  "repository": "github:ayan-de/heatmap",
  "homepage": "https://github.com/ayan-de/heatmap#readme",
  "devDependencies": {
    "@types/node": "^20.19.42",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "dependencies": {
    "commander": "^15.0.0"
  }
}
